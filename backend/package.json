{
  "name": "library-management-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for the Library Management System coursework",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run prisma:generate && tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.test.json",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "db:check": "npm run prisma:generate && tsx scripts/check-database.ts",
    "db:seed": "npm run prisma:generate && prisma db seed",
    "db:init-cloud": "npm run prisma:generate && tsx scripts/init-cloud.ts",
    "db:check-seed": "npm run prisma:generate && tsx scripts/check-seed.ts",
    "db:check-books": "npm run prisma:generate && tsx scripts/check-books.ts",
    "db:check-book-copies": "npm run prisma:generate && tsx scripts/check-book-copies.ts",
    "db:check-readers": "npm run prisma:generate && tsx scripts/check-readers.ts",
    "db:check-auth": "npm run prisma:generate && tsx scripts/check-auth.ts",
    "db:check-rentals": "npm run prisma:generate && tsx scripts/check-rentals.ts",
    "db:check-reports": "npm run prisma:generate && tsx scripts/check-reports.ts",
    "db:check-settings": "npm run prisma:generate && tsx scripts/check-settings.ts",
    "db:migrate-condition-check": "npm run prisma:generate && tsx scripts/check-condition-migration.ts",
    "auth:bootstrap-admin": "npm run prisma:generate && tsx scripts/bootstrap-admin.ts",
    "db:preflight": "tsx scripts/check-schema.ts --expect-empty",
    "db:check-schema": "tsx scripts/check-schema.ts",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "8.23.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@prisma/config": { "effect": "3.22.5" }
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
