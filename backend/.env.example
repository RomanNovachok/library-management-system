NODE_ENV=development
PORT=3000
# Exact frontend origin: scheme + host + optional port, without a trailing slash.
CORS_ORIGIN=http://localhost:5173
# Local PostgreSQL. Replace YOUR_URL_ENCODED_PASSWORD with the URL-encoded root .env password.
# This example contains no real password. Keep DATABASE_URL on the backend only.
DATABASE_URL="postgresql://library_user:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5433/library_db?schema=public"
