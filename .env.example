# Local Docker Compose configuration. Copy this file to .env in the repository root.
# Existing .env files must not be overwritten; edit them instead.
POSTGRES_DB=library_db
POSTGRES_USER=library_user
POSTGRES_HOST_PORT=5433

# Required: set your own non-empty local password in .env before starting db.
# Never commit .env. Use single quotes around a password containing $ or #.
POSTGRES_PASSWORD=
