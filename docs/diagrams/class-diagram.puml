@startuml
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0

package "Domain" #F5F5F5 {
  class Book {
    +id: UUID
    +title: string
    +author: string
    +genre: string
    +dailyPrice: Decimal
    +depositAmount: Decimal
    +archivedAt: DateTime?
  }
  class BookCopy {
    +id: UUID
    +bookId: UUID
    +inventoryCode: string
    +status: CopyStatus
    +condition: CopyCondition
    +conditionNotes: string?
  }
  enum CopyCondition {
    GOOD
    MINOR_DAMAGE
    MAJOR_DAMAGE
    LOST
    UNKNOWN
  }
  class Reader {
    +id: UUID
    +fullName: string
    +address: string
    +phone: string
    +categoryId: UUID
  }
  class ReaderCategory {
    +id: UUID
    +name: string
    +discountPercent: Decimal
  }
  class Rental {
    +issuedAt: DateTime
    +dueAt: DateTime
    +closedAt: DateTime?
    +status: RentalStatus
    +pricePerDaySnapshot: Decimal
    +depositSnapshot: Decimal
    +discountPercentSnapshot: Decimal
    +readerCategorySnapshot: string
    +damagePercentSnapshot: Decimal?
    +rentalFee: Decimal?
    +damageFine: Decimal?
    +refundAmount: Decimal?
    +additionalPayment: Decimal?
    +conditionAtIssue: CopyCondition?
    +conditionNotesAtIssue: string?
    +conditionAtReturn: CopyCondition?
    +conditionNotesAtReturn: string?
    +newDamageNotes: string?
  }
  class DamageRule {
    +code: string
    +label: string
    +penaltyPercent: Decimal
    +outcome: DamageOutcome
  }
  class CashMovement {
    +type: CashMovementType
    +amount: Decimal
    +createdAt: DateTime
  }
  class AuditLog {
    +id: UUID
    +actorId: UUID
    +action: string
    +entityType: string
    +entityId: UUID
    +createdAt: DateTime
    +details: Json?
  }
  class StaffUser {
    +id: UUID
    +email: string
    -passwordHash: string
    +role: StaffRole
    +isActive: boolean
  }
  class StaffSession {
    -tokenHash: string
    +staffUserId: UUID
    +expiresAt: DateTime
  }
  Book "1" -- "*" BookCopy
  ReaderCategory "1" -- "*" Reader
  Reader "1" -- "*" Rental
  BookCopy "1" -- "*" Rental
  DamageRule "0..1" -- "*" Rental : rule at closure
  Rental "1" -- "*" CashMovement
  StaffUser "1" -- "*" CashMovement : records
  StaffUser "1" -- "*" AuditLog : performs
  StaffUser "1" -- "*" StaffSession : authenticates
}

package "auth і staff — реалізований backend" #E3EAFE {
  class AuthController {
    +login(req, res)
    +logout(req, res)
    +me(req, res)
    +changePassword(req, res)
  }
  class AuthService {
    +login(email, password, address, previousHash)
    +logout(tokenHash)
    +authenticate(tokenHash): StaffIdentity
    +changePassword(id, tokenHash, oldPassword, newPassword)
  }
  class StaffController {
    +list(req, res)
    +create(req, res)
    +update(req, res)
    +resetPassword(req, res)
  }
  class StaffService {
    +bootstrap(email, password)
    +list()
    +create(tokenHash, email, role, password)
    +update(tokenHash, id, patch)
    +resetPassword(tokenHash, id, password)
  }
  interface AuthRepository {
    +authenticate(tokenHash, now)
    +findAccount(id)
    +findByEmail(email)
    +listAccounts()
    +transaction(operation)
  }
  class PrismaAuthRepository
  AuthController --> AuthService
  StaffController --> StaffService
  AuthService --> AuthRepository
  StaffService --> AuthRepository
  PrismaAuthRepository ..|> AuthRepository
  PrismaAuthRepository ..> StaffUser
  PrismaAuthRepository ..> StaffSession
}

package "books — реалізований backend" #E3EAFE {
  class BooksController {
    +list(req, res): void
    +getById(req, res): void
    +create(req, res): void
    +update(req, res): void
    +archive(req, res): void
  }
  class BooksService {
    +list(query): Catalog
    +getById(id): BookDetails
    +create(input): Book
    +update(id, input): BookDetails
    +archive(id): void
  }
  interface BooksRepository {
    +list(query): BookPage
    +findById(id): BookDetails?
    +create(input): Book
    +update(id, input): BookWriteResult
    +archive(id, archivedAt): BookWriteResult
  }
  class PrismaBooksRepository
  BooksController --> BooksService
  BooksService --> BooksRepository
  BooksRepository <|.. PrismaBooksRepository
  PrismaBooksRepository ..> Book : reads / writes
  PrismaBooksRepository ..> BookCopy : reads / counts
  note bottom of PrismaBooksRepository
    Спільний Prisma Client.
    UPDATE лише з archivedAt IS NULL.
    DELETE API змінює лише archivedAt.
    Решта діаграми — проєктні класи.
  end note
}

package "book-copies — реалізований backend" #E3EAFE {
  class BookCopiesController {
    +list(req, res): void
    +getById(req, res): void
    +create(req, res): void
    +update(req, res): void
    +delete(req, res): void
  }
  class BookCopiesService {
    +list(bookId, query): BookCopy[]
    +getById(bookId, copyId): BookCopy
    +create(bookId, input): BookCopy
    +update(bookId, copyId, input): BookCopy
    +delete(bookId, copyId): void
  }
  interface BookCopiesRepository {
    +findBook(bookId): CopyBook?
    +list(bookId, status): BookCopy[]
    +findById(bookId, copyId): BookCopy?
    +transaction(operation): T
  }
  interface BookCopiesWriteRepository {
    +lockBook(bookId): CopyBook?
    +lockCopy(bookId, copyId): BookCopy?
    +hasRentals(copyId, activeOnly): boolean
    +create(input: NewBookCopy): BookCopy
    +update(copy, input): BookCopy
    +delete(copy): void
  }
  class PrismaBookCopiesRepository
  class PrismaBookCopiesWriteRepository
  BookCopiesController --> BookCopiesService
  BookCopiesService --> BookCopiesRepository
  BookCopiesService ..> BookCopiesWriteRepository : transaction callback
  BookCopiesRepository <|.. PrismaBookCopiesRepository
  BookCopiesWriteRepository <|.. PrismaBookCopiesWriteRepository
  PrismaBookCopiesRepository ..> PrismaBookCopiesWriteRepository : creates in transaction
  PrismaBookCopiesWriteRepository ..> Book : locks / reads
  PrismaBookCopiesWriteRepository ..> BookCopy : locks / writes
  PrismaBookCopiesWriteRepository ..> Rental : reads only
  note bottom of PrismaBookCopiesWriteRepository
    Book FOR SHARE NOWAIT, потім BookCopy FOR UPDATE NOWAIT.
    CRUD статуси: AVAILABLE / MAINTENANCE.
    DELETE: AVAILABLE без жодного Rental.
    Конфлікти: 409; історія зберігається.
  end note
}

package "readers — реалізований backend" #E3EAFE {
  class ReadersController {
    +list(req, res): void
    +getById(req, res): void
    +create(req, res): void
    +update(req, res): void
    +categories(req, res): void
    +rentals(req, res): void
  }
  class ReadersService {
    +list(query): ReaderPage
    +getById(id): ReaderDetails
    +create(input): ReaderDetails
    +update(id, input): ReaderDetails
    +categories(): ReaderCategory[]
    +rentals(id, query): RentalPage
  }
  interface ReadersRepository {
    +list(query): ReaderPage
    +findById(id): ReaderDetails?
    +findCategory(id): ReaderCategory?
    +categories(): ReaderCategory[]
    +create(input): ReaderDetails
    +update(id, input): ReaderDetails
    +rentals(id, query): RentalPage
  }
  class PrismaReadersRepository
  ReadersController --> ReadersService
  ReadersService --> ReadersRepository
  ReadersRepository <|.. PrismaReadersRepository
  PrismaReadersRepository ..> Reader : reads / writes
  PrismaReadersRepository ..> ReaderCategory : reads only
  PrismaReadersRepository ..> Rental : reads only
  PrismaReadersRepository ..> BookCopy : reads history
  PrismaReadersRepository ..> Book : reads title
  note bottom of ReadersService
    Усі endpoints: чинний сеанс працівника.
    Категорії з БД, поточна знижка Decimal.
    PATCH лише переданих полів Reader.
    Історичні знімки Rental незмінні.
    Історія показує прокати з модуля Rentals.
  end note
}

package "Strategy — знижки" #DFF1E5 {
  interface DiscountStrategy <<Strategy>> {
    +apply(subtotal: Decimal): Decimal
  }
  class NoDiscountStrategy <<ConcreteStrategy>>
  class PercentageDiscountStrategy <<ConcreteStrategy>> {
    -percent: Decimal
  }
  class RentalCalculator <<Context>> {
    -discount: DiscountStrategy
    +calculate(rental, rule, closedAt): Settlement
  }
  DiscountStrategy <|.. NoDiscountStrategy
  DiscountStrategy <|.. PercentageDiscountStrategy
  RentalCalculator --> DiscountStrategy : delegates
}

package "Observer — події" #E3EAFE {
  interface RentalEventSubscriber <<Observer>> {
    +onRentalEvent(event: RentalEvent): Promise<void>
  }
  class RentalEventPublisher <<Subject>> {
    +subscribe(subscriber): Unsubscribe
    +publish(event: RentalEvent): Promise<void>
  }
  class AuditLogSubscriber <<ConcreteObserver>>
  interface RentalEvent <<union>> {
    rentalId: UUID
    actorId: UUID
    occurredAt: Date
  }
  interface RentalIssued <<Event>>
  interface RentalClosed <<Event>> {
    status: RentalStatus
    copyStatus: DamageOutcome
    damageRuleId: UUID
    conditionAtIssue: CopyCondition?
    condition: CopyCondition
    ruleCode: string
    damagePercent: string
  }
  RentalEvent ..> RentalIssued : union member
  RentalEvent ..> RentalClosed : union member
  RentalEventSubscriber <|.. AuditLogSubscriber
  RentalEventPublisher o-- RentalEventSubscriber
  RentalEventPublisher ..> RentalEvent
  AuditLogSubscriber ..> AuditLog : writes
}

package "Template Method — генератори звітів" #FFF1D6 {
  abstract class "BaseReport<Params, Data, Aggregated, Result>" as BaseReport <<Template Method>> {
    +generate(params): Promise<Result>
    #fetchData(params): Promise<Data>
    #aggregate(data): Aggregated
    #format(data): Result
  }
  class InventoryReport
  class RentalsReport
  class FinancialReport
  BaseReport <|-- InventoryReport
  BaseReport <|-- RentalsReport
  BaseReport <|-- FinancialReport
}

package "Factory Method — творці звітів" #FBE3E9 {
  abstract class "ReportCreator<Params, Result>" as ReportCreator <<Creator>> {
    +createReport(): Product
    +generate(params): Promise<Result>
  }
  class InventoryReportCreator <<ConcreteCreator>>
  class RentalsReportCreator <<ConcreteCreator>>
  class FinancialReportCreator <<ConcreteCreator>>
  ReportCreator <|-- InventoryReportCreator
  ReportCreator <|-- RentalsReportCreator
  ReportCreator <|-- FinancialReportCreator
  InventoryReportCreator ..> InventoryReport : creates
  RentalsReportCreator ..> RentalsReport : creates
  FinancialReportCreator ..> FinancialReport : creates
  ReportCreator ..> BaseReport : generates through the product contract
}

package "Reports — читання статистики" #E9F3EB {
  class ReportsController {
    +inventory(req, res)
    +rentals(req, res)
    +financial(req, res)
    +dashboard(req, res)
  }
  class ReportService {
    +inventory(query)
    +rentals(query)
    +financial(query)
    +dashboard(query)
  }
  interface ReportsRepository {
    +read(operation)
  }
  class PrismaReportsRepository
  class PrismaReportsData {
    +inventory(query)
    +rentals(query, period, now)
    +financial(query, period)
    +dashboard(period, now)
  }
  ReportsController --> ReportService
  ReportService --> "3" ReportCreator : typed registry
  ReportService --> ReportsRepository : dashboard
  ReportCreator --> ReportsRepository : injects into products
  InventoryReport --> ReportsRepository
  RentalsReport --> ReportsRepository
  FinancialReport --> ReportsRepository
  ReportsRepository <|.. PrismaReportsRepository
  PrismaReportsRepository ..> PrismaReportsData : read-only snapshot
  PrismaReportsData ..> Book : reads
  PrismaReportsData ..> BookCopy : reads
  PrismaReportsData ..> Reader : reads
  PrismaReportsData ..> Rental : reads
  PrismaReportsData ..> CashMovement : reads
  PrismaReportsData ..> StaffUser : reads
}

package "Rentals — видача і повернення" {
  class RentalsController {
    +list()
    +details()
    +damageRules()
    +issue()
    +preview()
    +close()
  }
  class RentalsService {
    +list(query): RentalPage
    +details(id): RentalDetails
    +damageRules(): DamageRule[]
    +issue(input, actorId, termsVersion?): RentalDetails
    +preview(id, input): ReturnPreview
    +close(id, input, actorId): RentalDetails
  }
  interface RentalsRepository {
    +read(operation)
    +transaction(operation)
    +damageRules(): DamageRule[]
  }
  class PrismaRentalsRepository
  class "rental-condition.ts" as RentalCondition <<module>> {
    +conditionForIssue(copy, inspection): CopyConditionData
    +conditionForReturn(rental, input): ReturnCondition
  }
  RentalsController --> RentalsService
  RentalsService ..> RentalCondition
  RentalsService --> RentalsRepository
  RentalsRepository <|.. PrismaRentalsRepository
  PrismaRentalsRepository ..> Rental : reads and writes
  PrismaRentalsRepository ..> BookCopy : locks and updates
  PrismaRentalsRepository ..> DamageRule : reads
  PrismaRentalsRepository ..> CashMovement : records
}
RentalsService ..> RentalCalculator : shares between preview and close
RentalsService ..> NoDiscountStrategy : selects
RentalsService ..> PercentageDiscountStrategy : selects with snapshot
RentalsService --> RentalEventPublisher : publishes after commit
note right of RentalsService
  Операції видачі / повернення
  виконуються транзакційно.
  Ціна, знижка, застава — snapshots.
  Штраф і доступність визначаються
  тяжкістю нових пошкоджень і загальним станом відповідно.
end note
@enduml
